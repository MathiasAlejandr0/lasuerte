NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Hostinger MySQL Database (dejar vacío si se usa modo memoria/demo)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
# MYSQL_SSL=true

# Payments: en local, mock activo por defecto. En producción siempre desactivado.
# PAYMENTS_MOCK=false

# Flow.cl Pasarela de Pagos (Webpay, Servipag, tarjetas en Chile)
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_ENV=sandbox

# Resend
RESEND_API_KEY=
EMAIL_FROM=Suertu2s <contacto@suertu2s.com>

# Admin (fail closed without these)
ADMIN_EMAILS=admin@suertu2s.cl
ADMIN_PASSWORD=change-me-strong-password
# Preferido en producción: hash scrypt (formato scrypt$salt$hash). Si está, se ignora ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=
# Obligatorio en producción (no reutilices la contraseña)
ADMIN_SESSION_SECRET=change-me-long-random-secret

# Affiliate portal
# AFFILIATE_SESSION_SECRET=
AFFILIATE_DEMO_PASSWORD=afiliado-demo

# Redes Sociales
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/suertu2s/
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/profile.php?id=61590580826151
