NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Payments: en local, mock activo por defecto. En producción siempre desactivado.
# PAYMENTS_MOCK=false

# MercadoPago (leave empty until client provides keys)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# En staging, fuerza verificación de firma aunque no sea production:
# MERCADOPAGO_REQUIRE_WEBHOOK_SECRET=true

# Transbank Webpay Plus (integration defaults for sandbox only)
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C
WEBPAY_ENV=integration

# Resend
RESEND_API_KEY=
EMAIL_FROM=Suertu2s <noreply@suertu2s.cl>

# Admin (fail closed without these)
ADMIN_EMAILS=admin@suertu2s.cl
ADMIN_PASSWORD=change-me-strong-password
# Preferido en producción: hash scrypt (formato scrypt$salt$hash). Si está, se ignora ADMIN_PASSWORD.
# ADMIN_PASSWORD_HASH=
# Obligatorio en producción (no reutilices la contraseña)
ADMIN_SESSION_SECRET=change-me-long-random-secret

# Affiliate portal
# AFFILIATE_SESSION_SECRET=
AFFILIATE_DEMO_PASSWORD=afiliado-demo

# Confía en X-Forwarded-For / X-Real-IP (Vercel, Cloudflare, nginx). Actívalo en deploy.
TRUST_PROXY=true

# WhatsApp del widget "Consulta tu pedido" (solo dígitos, con código país). Ej: 56912345678
# NEXT_PUBLIC_WHATSAPP_NUMBER=
